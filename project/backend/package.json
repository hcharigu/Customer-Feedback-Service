{
  "name": "customer-feedback-service",
  "version": "1.0.0",
  "private": true,
  "description": "Local customer feedback submission and review service.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node scripts/build.js",
    "test": "vitest run --config vitest.config.js",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:ui": "vitest run --config vitest.ui.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:coverage": "vitest run --config vitest.config.js --coverage",
    "coverage": "npm run test:coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
